# Rollovercollection 3 - OHE: constants.
# Used when the extension is included as static TypoScript template (sys_template record).
# Sites using the site set "Specialistaweb/Rollovercollection3" get the same values from
# Configuration/Sets/Rollovercollection3/settings.definitions.yaml (Site Management > Settings).
# Keep the defaults of the two files in sync.

# customsubcategory=general=General
plugin.tx_rollovercollection3_rollovereffect3 {
  view {
    # cat=bootstrap package: rollovercollection3-ohe/general/010; type=string; label=Path to the SCSS folder. Must contain theme.scss, with trailing slash
    scssPath = EXT:rollovercollection3/Resources/Public/Scss/Theme/
  }
  settings {
    # cat=bootstrap package: rollovercollection3-ohe/general/020; type=boolean; label=Title: keep HTML typed by editors. Cleaned by the TYPO3 HTML sanitizer. Off = plain text
    titleRawdataOutput = 1
    # cat=bootstrap package: rollovercollection3-ohe/general/030; type=boolean; label=Caption: keep HTML typed by editors. Cleaned by the TYPO3 HTML sanitizer. Off = formatted with lib.parseFunc_RTE
    captionRawdataOutput = 0
    # cat=bootstrap package: rollovercollection3-ohe/general/040; type=boolean; label=Show the "more" button. Shown only when the image has a link
    useButtonMore = 1
    # cat=bootstrap package: rollovercollection3-ohe/general/050; type=int+; label=Maximum image width in pixels. 0 = original file
    imageMaxWidth = 1140
  }
}

#####################
### SCSS SETTINGS ###
#####################

# customsubcategory=size=Size
# customsubcategory=colors=Colors
# customsubcategory=mask=Mask background

plugin.bootstrap_package.settings.scss {

  # cat=bootstrap package: rollovercollection3-ohe/size/101; type=string; label=$rollover3-block-maxwidth: maximum width of each box (px or %)
  rollover3-block-maxwidth = 100%

  # cat=bootstrap package: rollovercollection3-ohe/colors/102; type=string; label=$rollover3-brand-primary: base color
  rollover3-brand-primary = #000
  # cat=bootstrap package: rollovercollection3-ohe/colors/103; type=string; label=$rollover3-title-textcolor: title text color
  rollover3-title-textcolor = white
  # cat=bootstrap package: rollovercollection3-ohe/colors/104; type=string; label=$rollover3-title-bgcolor: title background color
  rollover3-title-bgcolor = $rollover3-brand-primary
  # cat=bootstrap package: rollovercollection3-ohe/colors/105; type=string; label=$rollover3-caption-textcolor: caption text color
  rollover3-caption-textcolor = white
  # cat=bootstrap package: rollovercollection3-ohe/colors/106; type=string; label=$rollover3-caption-bgcolor: caption background color
  rollover3-caption-bgcolor = transparent
  # cat=bootstrap package: rollovercollection3-ohe/colors/107; type=string; label=$rollover3-button-textcolor: button text color
  rollover3-button-textcolor = white
  # cat=bootstrap package: rollovercollection3-ohe/colors/108; type=string; label=$rollover3-button-bgcolor: button background color
  rollover3-button-bgcolor = $rollover3-brand-primary
  # cat=bootstrap package: rollovercollection3-ohe/colors/109; type=string; label=$rollover3-button-hover-bgcolor: button background color on hover
  rollover3-button-hover-bgcolor = lighten($rollover3-button-bgcolor,16)

  # cat=bootstrap package: rollovercollection3-ohe/mask/110; type=string; label=$rollover3-mask-style1-bgcolor: mask background color, style#1
  rollover3-mask-style1-bgcolor = rgba(0,0,0,0.5)
  # cat=bootstrap package: rollovercollection3-ohe/mask/111; type=string; label=$rollover3-mask-style2-bgcolor: mask background color, style#2
  rollover3-mask-style2-bgcolor = rgba(0,0,0,0.4)
  # cat=bootstrap package: rollovercollection3-ohe/mask/112; type=string; label=$rollover3-mask-style3-bgcolor: mask background color, style#3
  rollover3-mask-style3-bgcolor = rgba(0,0,0,0.4)
  # cat=bootstrap package: rollovercollection3-ohe/mask/113; type=string; label=$rollover3-mask-style4-bgcolor: mask background color, style#4
  rollover3-mask-style4-bgcolor = rgba(0,0,0,0.9)
  # cat=bootstrap package: rollovercollection3-ohe/mask/114; type=string; label=$rollover3-mask-style5-bgcolor: mask background color, style#5
  rollover3-mask-style5-bgcolor = rgba(0,0,0,0.3)
  # cat=bootstrap package: rollovercollection3-ohe/mask/115; type=string; label=$rollover3-mask-style6-bgcolor: mask background color, style#6
  rollover3-mask-style6-bgcolor = rgba(0,0,0,0.5)
  # cat=bootstrap package: rollovercollection3-ohe/mask/116; type=string; label=$rollover3-mask-style7-bgcolor: mask background color, style#7
  rollover3-mask-style7-bgcolor = rgba(0,0,0,0.9)
  # cat=bootstrap package: rollovercollection3-ohe/mask/117; type=string; label=$rollover3-mask-style8-bgcolor: mask background color, style#8
  rollover3-mask-style8-bgcolor = rgba(255,255,255,0.7)
  # cat=bootstrap package: rollovercollection3-ohe/mask/118; type=string; label=$rollover3-mask-style9-bgcolor: mask background color, style#9
  rollover3-mask-style9-bgcolor = rgba(0,0,0,0.2)
  # cat=bootstrap package: rollovercollection3-ohe/mask/119; type=string; label=$rollover3-mask-style10-bgcolor: mask background color, style#10
  rollover3-mask-style10-bgcolor = rgba(255,255,255,0.8)
}
