# Rollovercollection 3 - OHE
# Requires bootstrap_package (content elements image, textpic, media, textmedia).

# Label of the "more" button
lib.rollovercollection3.label.readMore = TEXT
lib.rollovercollection3.label.readMore {
  value = READ MORE
  lang.it = DETTAGLI
}

# Partials of this extension are added on top of the bootstrap_package ones,
# but only for content elements using one of the OHE layouts (tt_content.layout).
# Every other layout keeps the plain bootstrap_package rendering.
tt_content.image.partialRootPaths {
  2750 = EXT:rollovercollection3/Resources/Private/Partials/ContentElements/
  2750.stdWrap.if {
    value = 2750,2751,2752,2753,2754,2755,2756,2757,2758,2759
    isInList.field = layout
  }
}
tt_content.textpic.partialRootPaths {
  2750 = EXT:rollovercollection3/Resources/Private/Partials/ContentElements/
  2750.stdWrap.if {
    value = 2750,2751,2752,2753,2754,2755,2756,2757,2758,2759
    isInList.field = layout
  }
}
tt_content.media.partialRootPaths {
  2750 = EXT:rollovercollection3/Resources/Private/Partials/ContentElements/
  2750.stdWrap.if {
    value = 2750,2751,2752,2753,2754,2755,2756,2757,2758,2759
    isInList.field = layout
  }
}
tt_content.textmedia.partialRootPaths {
  2750 = EXT:rollovercollection3/Resources/Private/Partials/ContentElements/
  2750.stdWrap.if {
    value = 2750,2751,2752,2753,2754,2755,2756,2757,2758,2759
    isInList.field = layout
  }
}

# Settings handed over to the partials as {settings.R3...}
tt_content.image.settings {
  R3titleRawdataOutput = {$plugin.tx_rollovercollection3_rollovereffect3.settings.titleRawdataOutput}
  R3captionRawdataOutput = {$plugin.tx_rollovercollection3_rollovereffect3.settings.captionRawdataOutput}
  R3useButtonMore = {$plugin.tx_rollovercollection3_rollovereffect3.settings.useButtonMore}
  R3imageMaxWidth = {$plugin.tx_rollovercollection3_rollovereffect3.settings.imageMaxWidth}
}
tt_content.textpic.settings {
  R3titleRawdataOutput = {$plugin.tx_rollovercollection3_rollovereffect3.settings.titleRawdataOutput}
  R3captionRawdataOutput = {$plugin.tx_rollovercollection3_rollovereffect3.settings.captionRawdataOutput}
  R3useButtonMore = {$plugin.tx_rollovercollection3_rollovereffect3.settings.useButtonMore}
  R3imageMaxWidth = {$plugin.tx_rollovercollection3_rollovereffect3.settings.imageMaxWidth}
}
tt_content.media.settings {
  R3titleRawdataOutput = {$plugin.tx_rollovercollection3_rollovereffect3.settings.titleRawdataOutput}
  R3captionRawdataOutput = {$plugin.tx_rollovercollection3_rollovereffect3.settings.captionRawdataOutput}
  R3useButtonMore = {$plugin.tx_rollovercollection3_rollovereffect3.settings.useButtonMore}
  R3imageMaxWidth = {$plugin.tx_rollovercollection3_rollovereffect3.settings.imageMaxWidth}
}
tt_content.textmedia.settings {
  R3titleRawdataOutput = {$plugin.tx_rollovercollection3_rollovereffect3.settings.titleRawdataOutput}
  R3captionRawdataOutput = {$plugin.tx_rollovercollection3_rollovereffect3.settings.captionRawdataOutput}
  R3useButtonMore = {$plugin.tx_rollovercollection3_rollovereffect3.settings.useButtonMore}
  R3imageMaxWidth = {$plugin.tx_rollovercollection3_rollovereffect3.settings.imageMaxWidth}
}

# Theme styles, compiled by the SCSS parser of bootstrap_package.
# The variables come from plugin.bootstrap_package.settings.scss.rollover3-*
page.includeCSS {
  rollovercollection3 = {$plugin.tx_rollovercollection3_rollovereffect3.view.scssPath}theme.scss
}
